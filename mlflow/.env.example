# MLflow stack environment variables
# Copy to .env and adjust before running: cp .env.example .env
#
# ⚠ Never commit .env — it is in .gitignore

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# ── RustFS (S3-compatible artifact store) ───────────────────────────────────
RUSTFS_ROOT_USER=minioadmin
RUSTFS_ROOT_PASSWORD=minioadmin
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# ── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_PORT=5000
MLFLOW_BUCKET=mlflow-artifacts
